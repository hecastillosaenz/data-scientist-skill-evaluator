{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "node",
      "vite/client"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "server",
    "shared",
    "web/src",
    "web/vite.config.ts",
    "test",
    "vitest.config.ts"
  ]
}
